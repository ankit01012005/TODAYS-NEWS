# Copy to .env.local and fill in real values. Never commit .env.local.

# The backend API, reachable server-to-server only — the browser never
# talks to it directly (docs/23 §11.4). Not prefixed NEXT_PUBLIC_* on
# purpose: it must never end up in client-side JS.
API_BASE_URL="http://localhost:3001"

# This app's own public origin — used to build absolute URLs in the
# sitemap and RSS feed (SEO-08, SEO-13). Not the API's origin.
SITE_URL="http://localhost:3000"

# Shared with the backend (its REVALIDATE_SECRET): lets the API purge the
# public page cache the moment a story is published or withdrawn. Any
# random string of 32+ characters, e.g. `openssl rand -hex 32`. Leave
# unset in development to fall back to the 60-second cache window.
# REVALIDATE_SECRET=
