# Copy to .env.local and fill in real values. Never commit .env.local.

# The backend API, reachable server-to-server only — the browser never
# talks to it directly (docs/23 §11.4). Not prefixed NEXT_PUBLIC_* on
# purpose: it must never end up in client-side JS.
API_BASE_URL="http://localhost:3001"

# This app's own public origin — used to build absolute URLs in the
# sitemap and RSS feed (SEO-08, SEO-13). Not the API's origin.
SITE_URL="http://localhost:3000"

# Shared with the backend (its REVALIDATE_SECRET): lets the API purge the
# public page cache the moment a story is published or withdrawn. Any
# random string of 32+ characters, e.g. `openssl rand -hex 32`. Leave
# unset in development to fall back to the 60-second cache window.
# REVALIDATE_SECRET=

# Number of reverse-proxy hops in front of THIS app (0 = reached directly).
# Set it in production to match the real topology, and to the same value
# the backend uses. It controls one thing: whether the /api/backend proxy
# believes the X-Forwarded-For it received and passes the client address on
# to the API. Left at 0, the proxy strips every forwarding header instead —
# which is correct when anyone can reach this app directly, because those
# headers are then attacker-controlled and the API's rate limiters key on
# them.
# TRUST_PROXY=1
