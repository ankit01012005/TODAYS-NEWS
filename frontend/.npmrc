# Refuse to install on a Node version other than the one this project
# targets (engines in package.json, and .nvmrc at the repo root).
#
# This is not pedantry. The lockfiles are npm artefacts, and npm 10 and
# npm 11 disagree about which optional native dependencies belong in them
# (@emnapi/*). A lockfile written by one and installed by the other fails
# `npm ci` with "package.json and package-lock.json are not in sync" —
# which is exactly how CI and both Docker builds broke while every
# developer machine was fine. Failing at install time, loudly, beats
# discovering it in a release.
engine-strict=true
