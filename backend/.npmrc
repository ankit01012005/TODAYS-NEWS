# Keep installs reproducible. The Node version this project targets is in
# .nvmrc and in package.json's engines field; CI and both Dockerfiles pin
# the same one, because npm 10 and npm 11 disagree about which optional
# native dependencies belong in a lockfile and a mismatch breaks `npm ci`
# with "package.json and package-lock.json are not in sync".
#
# engine-strict is deliberately NOT set here: it validates `engines` for
# every package in the resolved tree, and that tree is not the same on
# every platform — optional native packages that never install on a
# developer's machine do install on a Linux runner. A guard that behaves
# differently in CI than it does locally is worse than no guard.
save-exact=true
