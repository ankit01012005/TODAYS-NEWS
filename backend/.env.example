# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/today_news?schema=public"

# Optional — defaults shown.
# NODE_ENV=development            # development | test | production (production => Secure cookies)
# PORT=3001
# SESSION_COOKIE_NAME=today_news_session
# SESSION_TTL_HOURS=12

# Cross-origin access is OFF by default: the browser never calls this API
# directly (the Next.js app proxies server-to-server). Only list origins
# here if something else must call it from a browser.
# CORS_ORIGINS=https://cms.example.com,https://admin.example.com

# Number of reverse-proxy hops in front of this process (0 = none). Needed
# for correct client IPs in rate limiting and logs behind a load balancer.
# TRUST_PROXY=1
