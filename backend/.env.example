# Copy to .env and fill in real values. Never commit .env.
# Every variable is validated at boot (src/config/env.validation.ts); the
# process refuses to start with a missing or malformed required value.

# --- Database (required) -------------------------------------------------
# Runtime connections. On a managed Postgres with a pooler (Neon, Supabase,
# PgBouncer) this is the POOLED address.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/today_news?schema=public&sslmode=require"
# What `prisma migrate` connects through — a DIRECT, session-mode
# connection (poolers in transaction mode refuse migrations). Same value as
# DATABASE_URL when there is no pooler.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/today_news?schema=public&sslmode=require"

# --- Media storage: Cloudinary (required) -------------------------------
# Exactly as shown on the Cloudinary dashboard ("API environment variable").
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
# Folder uploads land in — lets one account host several environments.
# CLOUDINARY_FOLDER=today-news

# --- Server ---------------------------------------------------------------
# NODE_ENV=development            # development | test | production
# PORT=3001
# How much the process logs. Read per call, so it can be raised without a
# restart. "silent" suppresses everything (what the test suite uses).
# LOG_LEVEL=info                  # debug | info | warn | error | silent
# Include stack traces in production logs. Off by default: a stack can
# carry file paths and query fragments into a shared log index.
# LOG_STACKS=false
# Number of reverse-proxy hops in front of this process (0 = none). Needed
# for correct client IPs in rate limiting and logs behind a load balancer.
# TRUST_PROXY=1

# --- Sessions -------------------------------------------------------------
# SESSION_COOKIE_NAME=today_news_session   # must match frontend/lib/api/session.ts
# SESSION_TTL_HOURS=12

# --- Frontend link --------------------------------------------------------
# The public origin of the Next.js app: goes into emailed links and is where
# cache-invalidation calls are sent. Must be https in production.
APP_BASE_URL="http://localhost:3000"
# Shared with the frontend's REVALIDATE_SECRET. Any random string of 32+
# characters (`openssl rand -hex 32`). Required in production; optional in
# development (falls back to the frontend's 60-second cache window).
# REVALIDATE_SECRET=

# --- Email: invitations and password resets ------------------------------
# Leave MAIL_TRANSPORT unset and it follows SMTP_URL: set an SMTP_URL and
# real mail is sent; leave it out and messages (links included) are printed
# to stdout instead. Production REFUSES to start unless MAIL_TRANSPORT=smtp
# with SMTP_URL and MAIL_FROM set. MAIL_FROM must be a sender your provider
# lets you send as (Resend: a verified domain, or onboarding@resend.dev for
# tests to your own inbox).
# MAIL_TRANSPORT=smtp
# SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
# MAIL_FROM="Today News <newsroom@example.com>"

# --- Cross-origin access (normally off) ----------------------------------
# The browser never calls this API directly (the Next.js app proxies
# server-to-server). Only list origins if something else must call it
# from a browser.
# CORS_ORIGINS=https://cms.example.com
